---
import Base from '../layouts/Base.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { getIssues, issueUrl, longDate, shortDate, isoDate, readLabel, countLabel } from '../lib/issues';

const issues = await getIssues();
const [lead] = issues;

// Group by year, newest year first. The lead issue is listed too, but only shown while searching.
const years = [...new Set(issues.map((i) => i.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const groups = years.map((year) => ({
  year,
  issues: issues.filter((i) => i.data.date.getUTCFullYear() === year),
}));
const visibleCount = (list: typeof issues) => list.filter((i) => i !== lead).length;

const searchText = (i: (typeof issues)[number]) => `${i.data.number} ${i.data.title} ${i.data.summary}`.toLowerCase();
---

<Base
  title="The Six Figure Insider — Every issue, archived"
  description="Quick marketing lessons for SLPs, from an SLP and a digital marketer who built a business together. Every issue of The Six Figure Insider in one place."
>
  <header class="site-header">
    <div class="site-header__inner">
      <span class="site-header__start wide-only">{issues.length} issues and counting</span>
      <button type="button" class="icon-button narrow-only" aria-label="Search issues" aria-expanded="false" aria-controls="search-panel" data-search-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.6-3.6"></path></svg>
      </button>
      <a href="/" class="wordmark" aria-current="page">The Insider</a>
      <ThemeSwitch />
    </div>
  </header>

  <div id="search-panel" class="search-panel narrow-only" role="search">
    <div class="search-panel__clip">
      <div class="search-panel__inner">
        <label for="m-issue-search">Search the archive</label>
        <div class="search-panel__row">
          <input id="m-issue-search" class="search-input" type="search" placeholder="Topic, title or issue no." autocomplete="off" data-search-input />
          <button type="button" class="icon-button" aria-label="Close search" data-search-close>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
        </div>
        <p class="label" aria-live="polite" data-search-count>Newest first</p>
      </div>
    </div>
  </div>

  <main class="archive">
    <section class="intro">
      <div class="intro__text">
        <p class="intro__eyebrow">Every issue, archived</p>
        <h1 class="intro__title" aria-label="Every issue, in one place.">
          <span aria-hidden="true" data-typewriter><span>Every </span><span class="accent">issue</span><span>, in one place.</span><span class="tw-caret"></span></span>
        </h1>
        <script is:inline>
          // Empty the headline before first paint, then type it back in (skipped with reduced motion).
          (function () {
            var el = document.querySelector('[data-typewriter]');
            if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            // Reserve the finished headline's height so nothing below it jumps while typing.
            var h1 = el.parentNode;
            h1.style.minHeight = h1.offsetHeight + 'px';
            var parts = Array.prototype.slice.call(el.children, 0, 3);
            var texts = parts.map(function (p) { return p.textContent; });
            var total = texts.join('').length;
            parts.forEach(function (p) { p.textContent = ''; });
            var typed = 0;
            function render() {
              var left = typed;
              parts.forEach(function (p, i) {
                var n = Math.max(0, Math.min(texts[i].length, left));
                p.textContent = texts[i].slice(0, n);
                left -= texts[i].length;
              });
            }
            setTimeout(function () {
              var timer = setInterval(function () {
                typed += 1;
                render();
                if (typed >= total) {
                  clearInterval(timer);
                  h1.style.minHeight = '';
                }
              }, 85);
            }, 400);
          })();
        </script>
        <p class="intro__lede">
          Quick marketing lessons for SLPs, from an SLP and a digital marketer who built a business together. Read it fast, use it today.
        </p>
      </div>
      <div class="search wide-only" role="search">
        <label for="issue-search">Search the archive</label>
        <input id="issue-search" class="search-input" type="search" placeholder="Topic, title or issue no." autocomplete="off" data-search-input />
        <p class="label" aria-live="polite" data-search-count>Newest first</p>
      </div>
    </section>

    {
      lead && (
        <section class="lead" aria-labelledby="lead-title" data-lead>
          <div class="lead__meta">
            <span class="lead__eyebrow wide-only">Latest issue</span>
            <span class="numeral">{lead.data.number}</span>
            <span class="mono narrow-only" style="color: var(--accent-text)">Latest issue</span>
            <time class="label wide-only" datetime={isoDate(lead.data.date)}>{longDate(lead.data.date)}</time>
          </div>
          <div class="lead__body">
            <h2 id="lead-title" class="lead__title">
              <a href={issueUrl(lead)}>{lead.data.title}</a>
            </h2>
            <p class="lead__summary">{lead.data.summary}</p>
            <p class="mono narrow-only" style="margin: 0; color: var(--muted)">
              {shortDate(lead.data.date)} · {readLabel(lead.data.readTime)}
            </p>
            <div class="lead__actions">
              <a href={issueUrl(lead)} class="btn-primary">
                Read the Issue
                <span class="btn-primary__disc">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                </span>
              </a>
              <span class="label wide-only">{readLabel(lead.data.readTime)}</span>
            </div>
          </div>
        </section>
      )
    }

    <section class="issue-list" aria-label="All issues">
      {
        groups.map((group) => (
          <div class="year-group" data-year-group hidden={visibleCount(group.issues) === 0}>
            <div class="year-group__head">
              <h2>{group.year}</h2>
              <span class="label" data-year-count>
                {countLabel(visibleCount(group.issues))}
              </span>
            </div>
            <ol>
              {group.issues.map((issue) => (
                <li class="issue-row" data-issue data-search={searchText(issue)} data-is-lead={issue === lead ? '' : undefined} hidden={issue === lead}>
                  <span class="numeral" aria-hidden="true">{issue.data.number}</span>
                  <div class="issue-row__body">
                    <h3 class="issue-row__title">
                      <a href={issueUrl(issue)}>
                        <span class="visually-hidden">Issue {issue.data.number}: </span>
                        {issue.data.title}
                      </a>
                    </h3>
                    <p class="issue-row__summary">{issue.data.summary}</p>
                    <p class="issue-row__mono mono narrow-only">
                      {shortDate(issue.data.date)} · {readLabel(issue.data.readTime)}
                    </p>
                  </div>
                  <div class="issue-row__meta label wide-only">
                    <time datetime={isoDate(issue.data.date)}>{longDate(issue.data.date)}</time>
                    <span>{readLabel(issue.data.readTime)}</span>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
      <div class="empty" hidden data-empty>
        <p>No issues match that search.</p>
        <button type="button" class="btn-outline" data-search-clear>Clear Search</button>
      </div>
    </section>
  </main>
</Base>

<script>
  const inputs = [...document.querySelectorAll<HTMLInputElement>('[data-search-input]')];
  const counts = document.querySelectorAll<HTMLElement>('[data-search-count]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-issue]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-year-group]')];
  const lead = document.querySelector<HTMLElement>('[data-lead]');
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const panel = document.getElementById('search-panel')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]')!;
  const total = rows.length;
  const plural = (n: number) => `${n} ${n === 1 ? 'issue' : 'issues'}`;

  function filter(raw: string) {
    const q = raw.trim().toLowerCase();
    let matches = 0;
    rows.forEach((row) => {
      // Without a query the lead issue is featured above, so it's left out of the list.
      const show = q ? row.dataset.search!.includes(q) : !('isLead' in row.dataset);
      row.hidden = !show;
      if (show) matches += 1;
    });
    groups.forEach((group) => {
      const n = group.querySelectorAll('[data-issue]:not([hidden])').length;
      group.hidden = n === 0;
      group.querySelector('[data-year-count]')!.textContent = plural(n);
    });
    if (lead) lead.hidden = Boolean(q);
    empty.hidden = !q || matches > 0;
    const label = q ? `${matches} of ${plural(total)} match` : 'Newest first';
    counts.forEach((c) => (c.textContent = label));
  }

  function setQuery(value: string, from?: HTMLInputElement) {
    inputs.forEach((i) => {
      if (i !== from) i.value = value;
    });
    filter(value);
  }

  inputs.forEach((input) => input.addEventListener('input', () => setQuery(input.value, input)));

  document.querySelector('[data-search-clear]')!.addEventListener('click', () => {
    setQuery('');
    const visible = inputs.find((i) => i.offsetParent !== null);
    visible?.focus();
  });

  function setPanel(open: boolean) {
    panel.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    if (open) {
      panel.querySelector('input')!.focus();
    } else {
      toggle.focus();
    }
  }

  toggle.addEventListener('click', () => setPanel(!panel.hasAttribute('data-open')));
  document.querySelector('[data-search-close]')!.addEventListener('click', () => setPanel(false));
  panel.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setPanel(false);
  });

  // A query restored by the browser (back/forward) should still filter.
  const restored = inputs.find((i) => i.value);
  if (restored) setQuery(restored.value, restored);
</script>
